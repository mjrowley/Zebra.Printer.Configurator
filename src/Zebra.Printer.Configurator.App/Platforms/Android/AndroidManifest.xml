<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true"></application>

    <!-- NFC: required to tap-pair a Zebra printer -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <!-- Bluetooth: printer configuration happens over BluetoothConnection before the printer is on WiFi.
         MAC address comes from the NFC tag payload, not a BLE scan, so neverForLocation applies. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />

    <!-- Network: TcpConnection for the post-restart WiFi connection test, and reading the host device's
         current WiFi netmask/gateway to inherit into the printer's static IP configuration -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Android only returns the actual connected SSID (not a masked placeholder) to apps holding
         location permission - used solely to default the WiFi Configuration form's SSID field to
         the network the phone is already on. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Held only for the duration of a firmware transfer (LinkOsFirmwareUpdateService), so the
         ~41MB WiFi upload isn't interrupted if the screen locks partway through. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- FirmwareUpdateForegroundService: a wake lock alone doesn't exempt the app from Doze/App
         Standby's *network* throttling for a backgrounded app (confirmed on-device: a firmware
         transfer was aborted mid-write after several minutes with the screen locked, even with the
         wake lock held) - a foreground service of type "dataSync" is required for that. Android 14+
         requires the FOREGROUND_SERVICE_DATA_SYNC permission in addition to the base one whenever a
         service declares that type. POST_NOTIFICATIONS is required on Android 13+ to show the
         progress/completion notifications at all - requested at runtime (FirmwareUpdateLauncher),
         same pattern as Bluetooth's runtime permission request. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>