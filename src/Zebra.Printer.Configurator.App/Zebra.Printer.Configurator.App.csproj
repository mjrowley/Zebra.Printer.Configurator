<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Android-only: this app targets Zebra Link-OS printers via NFC/Bluetooth, which are Android-specific APIs. -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>Zebra.Printer.Configurator.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Zebra.Printer.Configurator.App</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.zebra.printer.configurator.app</ApplicationId>

        <!--
            Versioning policy (mirrors ECommerce.Mobile.SwiftPick/Fetch/Fetch.csproj):
              * VersionMajor.Minor are maintained by hand - bump on a real release.
              * ApplicationVersion (integer build number used by Android as the versionCode) is
                auto-computed below, not hand-typed - every build gets a fresh, monotonically
                increasing value, so "bump ApplicationVersion" is no longer a release-workflow step.
              * In CI, set APP_BUILD_NUMBER, BUILD_BUILDID (Azure DevOps) or GITHUB_RUN_NUMBER
                (GitHub Actions) to use that build counter instead - not currently wired up to any
                CI for this project, but kept for parity/future-proofing.
        -->
        <VersionMajor>1</VersionMajor>
        <VersionMinor>59</VersionMinor>
        <ApplicationDisplayVersion>$(VersionMajor).$(VersionMinor)</ApplicationDisplayVersion>
        <!-- Evaluate ApplicationVersion at project-evaluation time so Android tooling can read
             AndroidVersionCode when generating the manifest. This mirrors the SetAppVersion target
             below but runs earlier. -->
        <_CiBuildNumber Condition="'$(APP_BUILD_NUMBER)' != ''">$(APP_BUILD_NUMBER)</_CiBuildNumber>
        <_CiBuildNumber Condition="'$(_CiBuildNumber)' == '' AND '$(BUILD_BUILDID)' != ''">$(BUILD_BUILDID)</_CiBuildNumber>
        <_CiBuildNumber Condition="'$(_CiBuildNumber)' == '' AND '$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</_CiBuildNumber>

        <_DaysSinceEpoch>$([System.Math]::Floor($([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse('2024-01-01'))).TotalDays)))</_DaysSinceEpoch>
        <_MinutesBucket>$([System.Math]::Floor($([MSBuild]::Divide($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes), 15))))</_MinutesBucket>
        <_LocalBuildNumber>$([MSBuild]::Add($([MSBuild]::Multiply($(_DaysSinceEpoch), 100)), $(_MinutesBucket)))</_LocalBuildNumber>

        <ApplicationVersion Condition="'$(_CiBuildNumber)' != ''">$(_CiBuildNumber)</ApplicationVersion>
        <ApplicationVersion Condition="'$(_CiBuildNumber)' == ''">$(_LocalBuildNumber)</ApplicationVersion>

        <AndroidVersionCode>$(ApplicationVersion)</AndroidVersionCode>

        <!-- Set assembly informational version early so AssemblyInformationalVersionAttribute
             contains the computed build identifier at compile time. -->
        <InformationalVersion>$(ApplicationDisplayVersion)+build.$(ApplicationVersion)</InformationalVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <!-- Android 13 (API 33) through Android 16 (API 36) per project requirements. -->
        <SupportedOSPlatformVersion>33.0</SupportedOSPlatformVersion>
        <TargetPlatformVersion>36.0</TargetPlatformVersion>

        <!-- Workaround: with .NET SDK 10.0.302 + Android workload 36.1.43, profiled Release AOT
             fails ("Failed to load method ... due to Could not load ... System.Formats.Nrbf") in
             mono-aot-cross. Disabling profiled AOT until the Android workload/runtime packs catch up.
             Revisit removing this once the toolchain mismatch is fixed upstream. -->
        <RunAOTCompilation>false</RunAOTCompilation>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon: a network printer glyph (printer body + WiFi arcs), matching what this app
             actually does, in place of the default MAUI template icon. -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#146C94" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#146C94" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Zebra.Printer.Configurator.Core\Zebra.Printer.Configurator.Core.csproj" />
      <ProjectReference Include="..\Zebra.Printer.Configurator.Infrastructure.Android\Zebra.Printer.Configurator.Infrastructure.Android.csproj" />
      <ProjectReference Include="..\Zebra.Printer.Configurator.UI\Zebra.Printer.Configurator.UI.csproj" />
    </ItemGroup>

    <!--
        Compute ApplicationVersion as an auto-incrementing integer.
        Order of preference:
          1. APP_BUILD_NUMBER env var (manual override).
          2. BUILD_BUILDID         (Azure DevOps).
          3. GITHUB_RUN_NUMBER     (GitHub Actions).
          4. (DaysSince 2024-01-01) * 100 + (UTC minute-of-day / 15)
             — guaranteed monotonic for any local build at least 15 minutes apart,
             stays well within the 32-bit signed int limit until well past 2050.
    -->
    <Target Name="SetAppVersion" BeforeTargets="PrepareForBuild">
        <PropertyGroup>
            <_CiBuildNumber Condition="'$(APP_BUILD_NUMBER)' != ''">$(APP_BUILD_NUMBER)</_CiBuildNumber>
            <_CiBuildNumber Condition="'$(_CiBuildNumber)' == '' AND '$(BUILD_BUILDID)' != ''">$(BUILD_BUILDID)</_CiBuildNumber>
            <_CiBuildNumber Condition="'$(_CiBuildNumber)' == '' AND '$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</_CiBuildNumber>

            <!-- Use Math.Floor to produce plain integer values (avoids culture-specific formatting) -->
            <_DaysSinceEpoch>$([System.Math]::Floor($([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse('2024-01-01'))).TotalDays)))</_DaysSinceEpoch>
            <_MinutesBucket>$([System.Math]::Floor($([MSBuild]::Divide($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes), 15))))</_MinutesBucket>
            <_LocalBuildNumber>$([MSBuild]::Add($([MSBuild]::Multiply($(_DaysSinceEpoch), 100)), $(_MinutesBucket)))</_LocalBuildNumber>

            <ApplicationVersion Condition="'$(_CiBuildNumber)' != ''">$(_CiBuildNumber)</ApplicationVersion>
            <ApplicationVersion Condition="'$(_CiBuildNumber)' == ''">$(_LocalBuildNumber)</ApplicationVersion>

            <!-- Ensure Android tooling sees an integer versionCode -->
            <AndroidVersionCode>$(ApplicationVersion)</AndroidVersionCode>

            <InformationalVersion>$(ApplicationDisplayVersion)+build.$(ApplicationVersion)</InformationalVersion>
        </PropertyGroup>

        <Message Importance="high" Text="App version: $(ApplicationDisplayVersion) (build $(ApplicationVersion))" />
    </Target>

</Project>
