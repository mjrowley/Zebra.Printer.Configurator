@* Self-contained "push bag tag templates" existence-check + confirm-overwrite + deploy flow for a
   paired printer, shared between Pairing (right after tap-pairing) and Result (after a successful
   configuration). These are small (<2KB each) bundled ZPL format templates that work fine over
   whichever transport is currently active (Bluetooth or WiFi), unlike the firmware update which
   specifically requires WiFi - see LinkOsBagTagTemplateService's own doc comment.

   The trigger itself lives in the host page's PrinterActionsMenu overflow menu (RequestDeployAsync,
   called via @ref) rather than a button here - see PrinterActionsMenu's own doc comment for why. *@
@implements IDisposable
@inject IBagTagTemplateService TemplateService
@inject PrinterActivityMonitor ActivityMonitor

<div>
    @* The trigger now lives in the host page's PrinterActionsMenu overflow menu, which calls
       RequestDeployAsync() below via @ref - this component only renders once it's actually doing
       something (Checking onward). *@
    @if (_state == State.Checking)
    {
        <p data-testid="deploy-templates-checking">Checking printer for existing templates&hellip;</p>
    }
    else if (_state == State.Deploying)
    {
        <p data-testid="deploy-templates-progress">Sending bag tag templates to printer&hellip;</p>
    }
    else if (_state == State.Complete)
    {
        <p class="text-success" data-testid="deploy-templates-complete">Bag tag templates sent to the printer.</p>
    }
    else if (_state == State.Failed)
    {
        <p class="text-danger" data-testid="deploy-templates-error">@_errorMessage</p>
    }

    @if (_state == State.Confirming)
    {
        <div class="confirm-modal-backdrop" data-testid="deploy-templates-confirm-dialog">
            <div class="confirm-modal-box" role="alertdialog">
                <p data-testid="deploy-templates-confirm-message">
                    The following template(s) already exist on the printer and will be overwritten:
                    @string.Join(", ", _existingFileNames). Continue?
                </p>
                <div class="confirm-modal-actions">
                    <md-filled-button type="button" class="btn-error" data-testid="deploy-templates-confirm" @onclick="Deploy">Overwrite</md-filled-button>
                    <md-filled-tonal-button type="button" data-testid="deploy-templates-cancel" @onclick="Cancel">Cancel</md-filled-tonal-button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private enum State
    {
        Idle,
        Checking,
        Confirming,
        Deploying,
        Complete,
        Failed,
    }

    [Parameter, EditorRequired]
    public PrinterDevice Device { get; set; } = null!;

    /// <summary>
    /// Raised whenever this panel starts (true) or stops (false) using the printer's Bluetooth/WiFi
    /// connection, so a host page can disable other actions that would race it - the same reason
    /// FactoryResetPanel raises this.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsActiveChanged { get; set; }

    private State _state = State.Idle;
    private IReadOnlyList<string> _existingFileNames = [];
    private string? _errorMessage;
    private IDisposable? _activityToken;

    /// <summary>Starts the deploy flow - called via @ref by the host page's overflow menu item.</summary>
    public Task RequestDeployAsync() => StartDeploy();

    private async Task StartDeploy()
    {
        _errorMessage = null;
        await SetState(State.Checking);

        try
        {
            _existingFileNames = await TemplateService.GetExistingTemplateFileNamesAsync(Device);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not check for existing templates: {ex.Message}";
            await SetState(State.Failed);
            return;
        }

        if (_existingFileNames.Count > 0)
        {
            await SetState(State.Confirming);
            return;
        }

        await Deploy();
    }

    private async Task Deploy()
    {
        await SetState(State.Deploying);

        try
        {
            await TemplateService.DeployTemplatesAsync(Device);
            await SetState(State.Complete);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not send bag tag templates: {ex.Message}";
            await SetState(State.Failed);
        }
    }

    private Task Cancel() => SetState(State.Idle);

    // Explicit StateHasChanged() - can no longer rely on Blazor's automatic post-event-handler
    // render, since RequestDeployAsync (and everything else that calls this) is now typically
    // invoked externally (PrinterActionsMenu's menu item calling it via @ref), not from this
    // component's own @onclick the way it used to be - a parent's event handler re-rendering
    // doesn't cascade into re-rendering this component too unless its own parameters changed.
    private async Task SetState(State state)
    {
        var wasActive = IsActive(_state);
        _state = state;
        var isActive = IsActive(_state);
        StateHasChanged();

        if (wasActive != isActive)
        {
            if (isActive)
            {
                _activityToken = ActivityMonitor.Begin("Bag Tag Templates");
            }
            else
            {
                _activityToken?.Dispose();
                _activityToken = null;
            }

            await IsActiveChanged.InvokeAsync(isActive);
        }
    }

    private static bool IsActive(State state) => state is State.Checking or State.Confirming or State.Deploying;

    public void Dispose() => _activityToken?.Dispose();
}
