@* Reads back the printer's current WLAN settings on demand - deliberately not routed through the
   Activity Log, since the log is a running trace of actions, not a place to look up "what is the
   printer's config right now". Results/errors are rendered by the sibling
   CheckConfigurationResults component (sharing the same CheckConfigurationState), so this button
   can live in a page's sticky header while a long results table scrolls separately below. *@
@inject IPrinterConfigurationReader ConfigurationReader
@inject PrinterActivityMonitor ActivityMonitor

<button type="button" class="btn btn-outline-secondary" data-testid="check-configuration-button" disabled="@(State.Loading || Disabled)" @onclick="CheckConfiguration">
    @if (State.Loading)
    {
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
    }
    Check Configuration
</button>

@code {
    [Parameter, EditorRequired]
    public PrinterDevice Device { get; set; } = null!;

    [Parameter, EditorRequired]
    public CheckConfigurationState State { get; set; } = null!;

    /// <summary>Disables the button without hiding it - e.g. while a factory reset is in progress.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    private async Task CheckConfiguration()
    {
        State.SetLoading();

        using var _ = ActivityMonitor.Begin("Check Configuration");
        try
        {
            var values = await ConfigurationReader.ReadConfigurationAsync(Device);
            State.SetResults(values);
        }
        catch (Exception ex)
        {
            State.SetError($"Could not check configuration: {ex.Message}");
        }
    }
}
