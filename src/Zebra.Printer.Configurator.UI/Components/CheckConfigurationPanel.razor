@* Reads back the printer's current WLAN settings on demand and displays them inline - deliberately
   not routed through the Activity Log, since the log is a running trace of actions, not a place to
   look up "what is the printer's config right now". *@
@inject IPrinterConfigurationReader ConfigurationReader

<button type="button" class="btn btn-outline-secondary" data-testid="check-configuration-button" disabled="@(_loading || Disabled)" @onclick="CheckConfiguration">
    @if (_loading)
    {
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
    }
    Check Configuration
</button>

@if (_errorMessage is not null)
{
    <p class="text-danger" data-testid="check-configuration-error">@_errorMessage</p>
}

@if (_values is not null)
{
    <table class="table table-sm" data-testid="check-configuration-results">
        <tbody>
            @foreach (var value in _values)
            {
                <tr>
                    <td>@value.Key</td>
                    <td>@value.Value</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter, EditorRequired]
    public PrinterDevice Device { get; set; } = null!;

    /// <summary>Disables the button without hiding it - e.g. while a factory reset is in progress.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    private bool _loading;
    private string? _errorMessage;
    private IReadOnlyList<PrinterConfigurationValue>? _values;

    private async Task CheckConfiguration()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            _values = await ConfigurationReader.ReadConfigurationAsync(Device);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Could not check configuration: {ex.Message}";
            _values = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
