@* Renders whatever the host page's own CheckConfigurationState instance most recently produced
   (populated directly by Pairing.razor/Result.razor's merged-status-read methods, and refreshed by
   PrinterActionsMenu's "Recheck Configuration" menu item) - see CheckConfigurationState for why this
   lives in its own component rather than the button that used to trigger it. Each value is coloured
   by ConfigurationValueMatch: green if it matches what this app expects, red if it doesn't, default
   text colour for values this app doesn't set (Informational). *@
@using Zebra.Printer.Configurator.Core.Configuration
@implements IDisposable

@if (State.ErrorMessage is not null)
{
    <p class="status-text-error" data-testid="check-configuration-error">@State.ErrorMessage</p>
}

@if (State.Values is not null)
{
    <div class="config-list" data-testid="check-configuration-results">
        @foreach (var value in State.Values)
        {
            <div class="config-list-row">
                <span>@value.Key</span>
                <span class="config-list-value @MatchClass(value.Match)">@value.Value</span>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public CheckConfigurationState State { get; set; } = null!;

    private static string MatchClass(ConfigurationValueMatch match) => match switch
    {
        ConfigurationValueMatch.Matches => "config-value-match",
        ConfigurationValueMatch.Mismatch => "config-value-mismatch",
        _ => "",
    };

    private CheckConfigurationState? _subscribedState;

    protected override void OnParametersSet()
    {
        // A page hands this a brand new CheckConfigurationState instance whenever it resets (e.g.
        // Pairing.Retry(), a fresh device discovery) - re-subscribing on change means stale results
        // from a previous printer/attempt can't linger after that reset.
        if (ReferenceEquals(_subscribedState, State))
        {
            return;
        }

        if (_subscribedState is not null)
        {
            _subscribedState.Changed -= OnChanged;
        }

        State.Changed += OnChanged;
        _subscribedState = State;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribedState is not null)
        {
            _subscribedState.Changed -= OnChanged;
        }
    }
}
