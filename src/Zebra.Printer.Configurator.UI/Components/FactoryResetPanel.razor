@* Self-contained factory-reset confirm/progress/result flow for a paired printer. Shared between
   Pairing (right after tap-pairing) and Result (after a successful reconfiguration), rather than
   duplicating the same confirm-then-reset-then-remove-bond state machine on both pages. The trigger
   itself lives in the host page's PrinterActionsMenu overflow menu (RequestConfirmAsync, called via
   @ref) rather than a button here - see PrinterActionsMenu's own doc comment for why. *@
@implements IDisposable
@inject IPrinterFactoryResetService FactoryResetService
@inject IBluetoothPairingService BluetoothPairingService
@inject PrinterActivityMonitor ActivityMonitor

@switch (_state)
{
    case State.Idle:
        // Nothing rendered here - the trigger now lives in the host page's PrinterActionsMenu
        // overflow menu, which calls RequestConfirmAsync() below via @ref. This component only
        // renders once it's actually doing something (Confirming onward).
        break;

    case State.Confirming:
        <p class="text-danger" data-testid="factory-reset-warning">
            This erases all settings on the printer and restores factory defaults. It may also break
            the current Bluetooth pairing. Continue?
        </p>
        <md-filled-button type="button" class="btn-error" data-testid="factory-reset-confirm" @onclick="ConfirmFactoryReset">Factory Reset</md-filled-button>
        <md-filled-tonal-button type="button" data-testid="factory-reset-cancel" @onclick="() => SetState(State.Idle)">Cancel</md-filled-tonal-button>
        break;

    case State.Resetting:
        <p data-testid="factory-reset-progress">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Resetting printer to factory defaults&hellip;
        </p>
        break;

    case State.Complete:
        <div class="confirm-modal-backdrop" data-testid="factory-reset-complete-dialog">
            <div class="confirm-modal-box" role="alertdialog">
                <p data-testid="factory-reset-complete">
                    Factory reset command sent. The printer is restarting with default settings, and
                    its Bluetooth pairing has been removed.
                </p>
                <div class="confirm-modal-actions">
                    <md-filled-button type="button" @onclick="() => OnFinished.InvokeAsync()">Close</md-filled-button>
                </div>
            </div>
        </div>
        break;

    case State.Failed:
        <p class="text-danger" data-testid="factory-reset-error">@_errorMessage</p>
        <md-filled-button type="button" @onclick="() => OnFinished.InvokeAsync()">Try Again</md-filled-button>
        break;
}

@code {
    private enum State
    {
        Idle,
        Confirming,
        Resetting,
        Complete,
        Failed,
    }

    [Parameter, EditorRequired]
    public PrinterDevice Device { get; set; } = null!;

    /// <summary>Raised when the user dismisses a terminal (Complete/Failed) state via its button.</summary>
    [Parameter]
    public EventCallback OnFinished { get; set; }

    /// <summary>
    /// Raised whenever this panel moves out of (true) or back into (false) its idle state, so a
    /// host page can disable actions that would race a Bluetooth connection this panel is using, or
    /// that assume a printer configuration this panel might be about to wipe.
    /// </summary>
    [Parameter]
    public EventCallback<bool> IsActiveChanged { get; set; }

    private State _state = State.Idle;
    private string? _errorMessage;
    private IDisposable? _activityToken;

    /// <summary>Starts the confirm flow - called via @ref by the host page's overflow menu item.</summary>
    public Task RequestConfirmAsync() => SetState(State.Confirming);

    private async Task ConfirmFactoryReset()
    {
        await SetState(State.Resetting);

        try
        {
            await FactoryResetService.ResetToFactoryDefaultsAsync(Device);

            // The printer's own Bluetooth pairing key is reset along with everything else, so the
            // phone's stored bond is now stale and would otherwise make the next pairing attempt
            // fail - remove it so re-pairing starts clean.
            await BluetoothPairingService.RemoveBondAsync(Device.BluetoothMacAddress);

            await SetState(State.Complete);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Factory reset failed: {ex.Message}";
            await SetState(State.Failed);
        }
    }

    // Explicit StateHasChanged() - can no longer rely on Blazor's automatic post-event-handler
    // render, since RequestConfirmAsync (and everything else that calls this) is now typically
    // invoked externally (PrinterActionsMenu's menu item calling it via @ref), not from this
    // component's own @onclick the way it used to be - a parent's event handler re-rendering
    // doesn't cascade into re-rendering this component too unless its own parameters changed.
    private async Task SetState(State state)
    {
        var wasActive = _state != State.Idle;
        _state = state;
        var isActive = _state != State.Idle;
        StateHasChanged();

        if (wasActive != isActive)
        {
            if (isActive)
            {
                _activityToken = ActivityMonitor.Begin("Factory Reset");
            }
            else
            {
                _activityToken?.Dispose();
                _activityToken = null;
            }

            await IsActiveChanged.InvokeAsync(isActive);
        }
    }

    public void Dispose() => _activityToken?.Dispose();
}
