@* Automatically checks a newly-paired printer's Link-OS/firmware versions against the bundled
   baseline for its model, and blocks "Configure Printer" (via BlockingChanged) until the situation
   is resolved - either the printer is already up to date/newer, a firmware update completes, or the
   user explicitly Skips (unsupported model, or a needed update they don't want to run right now) or
   Cancels (returns to waiting for a different tap; only offered for the unsupported-model case,
   since a skipped update can still be run later - via a re-tap or Check Configuration - unlike an
   unsupported model, which never can).

   A firmware update can only ever be performed over WiFi (FirmwareUpdateLauncher needs a reachable
   IP), so the check itself doesn't even run until that's available - there's no point telling the
   user about an update they can't act on yet, and a never-configured printer has no WiFi at all when
   this first renders on Pairing.razor ("Configure Printer" is exactly what gives it one). Nothing
   renders and Configure isn't blocked in that case; callers are expected to re-render this component
   once WiFi might exist (e.g. Result.razor, after a successful configuration) so the check actually
   runs and can offer/enforce the update then.

   The actual transfer runs in FirmwareUpdateForegroundService (Android), not an inline awaited call
   here - a plain awaited Task tied to this component's lifecycle would be abandoned if the user
   navigates away, and wouldn't survive the screen locking either way. This component only asks
   IFirmwareUpdateLauncher to start it, then reflects progress/outcome via FirmwareUpdateStatusMonitor
   (a shared singleton the service also updates) - the notification and this in-app UI are two views
   onto the same state, not two disconnected mechanisms.

   Self-contained like FactoryResetPanel: owns its own service calls and internal state rather than
   splitting state out, since (unlike CheckConfigurationButton/Results) everything here renders in
   one place. *@
@implements IDisposable
@inject IPrinterVersionCheckService VersionCheckService
@inject IFirmwareUpdateLauncher FirmwareUpdateLauncher
@inject FirmwareUpdateStatusMonitor UpdateStatus
@inject IPrinterConnectionModeProvider ConnectionModeProvider
@inject PrinterConnectivityMonitor ConnectivityMonitor
@inject PrinterActivityMonitor ActivityMonitor

@if (_loading)
{
    <p data-testid="version-check-loading">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        Checking printer firmware version&hellip;
    </p>
}
else if (_updating)
{
    <p data-testid="update-firmware-progress">
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        @UpdateProgressText
    </p>
}
else if (_result is not null)
{
    switch (_result.Outcome)
    {
        case PrinterVersionOutcome.NewerThanExpected:
            <p class="text-warning" data-testid="version-check-newer">@NewerThanExpectedMessage</p>
            break;

        case PrinterVersionOutcome.NeedsUpdate:
            <p class="text-danger" data-testid="version-check-needs-update">@NeedsUpdateMessage</p>
            <button type="button" class="btn btn-primary" data-testid="update-firmware-button"
                    title="@UpdateDisabledReason" disabled="@(UpdateDisabledReason is not null)" @onclick="UpdateFirmware">
                Update Firmware
            </button>
            <button type="button" class="btn btn-secondary" data-testid="version-check-skip" @onclick="Skip">Skip for now</button>
            @if (_updateError is not null)
            {
                <p class="text-danger" data-testid="update-firmware-error">@_updateError</p>
            }
            break;

        case PrinterVersionOutcome.Unsupported:
            <p class="text-danger" data-testid="version-check-unsupported">@UnsupportedMessage</p>
            <button type="button" class="btn btn-secondary" data-testid="version-check-skip" @onclick="Skip">Skip</button>
            <button type="button" class="btn btn-outline-secondary" data-testid="version-check-cancel" @onclick="Cancel">Cancel</button>
            break;

        case PrinterVersionOutcome.UpToDate:
            <p class="text-success" data-testid="version-check-up-to-date">Printer firmware is up to date.</p>
            break;
    }
}

@code {
    private const string ExpectedLinkOsVersion = "7.6.2";
    private const string ExpectedFirmwareVersion = "V93.21.49Z";

    [Parameter, EditorRequired]
    public PrinterDevice Device { get; set; } = null!;

    /// <summary>
    /// The printer's WiFi IP address, if the automatic post-pairing WiFi check (Pairing.razor)
    /// already discovered and confirmed one - reused here to avoid a second Bluetooth round-trip
    /// just to ask the printer the same question again before switching transport for the update.
    /// </summary>
    [Parameter]
    public string? WifiIpAddress { get; set; }

    [Parameter]
    public EventCallback<bool> BlockingChanged { get; set; }

    /// <summary>Raised when the user presses Cancel on an unsupported-model result.</summary>
    [Parameter]
    public EventCallback OnCancelled { get; set; }

    private bool _loading = true;
    private PrinterVersionCheckResult? _result;
    private bool _skipped;
    private bool _updating;
    private FirmwareUpdateProgress? _updateProgress;
    private string? _updateError;
    private bool _wasBlocking;
    private IDisposable? _activityToken;

    private bool CanUpdateFirmware =>
        ConnectivityMonitor.Wifi == ConnectionIndicatorState.Connected && !string.IsNullOrWhiteSpace(WifiIpAddress);

    private bool Blocking => _updating || _result switch
    {
        { Outcome: PrinterVersionOutcome.Unsupported } => !_skipped,
        // Only blocks when an update could actually be performed right now - see the WiFi/deadlock
        // note above.
        { Outcome: PrinterVersionOutcome.NeedsUpdate } => CanUpdateFirmware && !_skipped,
        _ => false,
    };

    private string? UpdateDisabledReason =>
        CanUpdateFirmware ? null : "A WiFi connection to the printer is required to update firmware.";

    private string NewerThanExpectedMessage =>
        $"Connected printer has a higher firmware version than expected. Expected Link-OS version: {ExpectedLinkOsVersion} - printer version: {_result!.LinkOsVersionFound}. Expected firmware version: {ExpectedFirmwareVersion} - printer version: {_result!.FirmwareVersionFound}";

    private string NeedsUpdateMessage =>
        $"Connected printer requires a firmware update. Press 'Update Firmware' to update. Expected Link-OS version: {ExpectedLinkOsVersion} - printer version: {_result!.LinkOsVersionFound}. Expected firmware version: {ExpectedFirmwareVersion} - printer version: {_result!.FirmwareVersionFound}";

    private const string UnsupportedMessage =
        "Connected printer is an unsupported model for firmware update. Press 'Skip' to continue to printer configuration or 'Cancel' to connect to a different printer.";

    private string UpdateProgressText => _updateProgress switch
    {
        { Stage: FirmwareUpdateStage.Downloading, BytesWritten: { } written, TotalBytes: { } total } and { TotalBytes: > 0 } =>
            $"Sending firmware to printer... {written * 100L / total}%",
        { Stage: FirmwareUpdateStage.Downloading } => "Sending firmware to printer...",
        { Stage: FirmwareUpdateStage.AwaitingReboot } => "Firmware sent - printer is flashing and rebooting...",
        { Stage: FirmwareUpdateStage.Complete } => "Printer is back online.",
        _ => "Starting firmware update...",
    };

    protected override void OnInitialized()
    {
        ConnectivityMonitor.Changed += OnConnectivityChanged;
        UpdateStatus.Changed += OnUpdateStatusChanged;
    }

    // The "Update Firmware" button's enabled state - and now Blocking itself - depends on
    // ConnectivityMonitor.Wifi, a shared singleton this component reads directly rather than
    // receiving as a parameter - nothing else triggers a re-render/re-notification when that changes
    // externally (e.g. WiFi dropping mid-session), so this subscribes the same way MainLayout does
    // for the header indicators, and re-notifies BlockingChanged in case that flips too.
    private void OnConnectivityChanged(object? sender, EventArgs e) => InvokeAsync(NotifyBlockingChanged);

    private void OnUpdateStatusChanged(object? sender, EventArgs e) => InvokeAsync(HandleUpdateStatusChanged);

    protected override async Task OnInitializedAsync()
    {
        if (UpdateStatus.State == FirmwareUpdateRunState.Running)
        {
            // An update is already in flight (e.g. the user reopened the app mid-transfer) - reflect
            // that directly rather than kicking off a fresh Bluetooth version check, which would race
            // FirmwareUpdateForegroundService's own connection to the same printer (the same class of
            // concurrent-Bluetooth-connection bug fixed earlier for the WiFi/version checks).
            _loading = false;
            _updating = true;
            _updateProgress = UpdateStatus.Progress;
            await NotifyBlockingChanged();
            return;
        }

        if (!CanUpdateFirmware)
        {
            // A firmware update can only ever be performed over WiFi - no point running a Bluetooth
            // version check (or showing anything) for a result the user couldn't act on yet anyway.
            // See this component's own doc comment for the never-configured-printer/deadlock case
            // this most commonly applies to.
            _loading = false;
            await NotifyBlockingChanged();
            return;
        }

        _loading = true;
        using (ActivityMonitor.Begin("Firmware Version Check"))
        {
            _result = await VersionCheckService.CheckAsync(Device);
        }
        _loading = false;
        await NotifyBlockingChanged();
    }

    private async Task HandleUpdateStatusChanged()
    {
        switch (UpdateStatus.State)
        {
            case FirmwareUpdateRunState.Running:
                _updating = true;
                _updateProgress = UpdateStatus.Progress;
                _updateError = null;
                await NotifyBlockingChanged();
                break;

            case FirmwareUpdateRunState.Succeeded:
                _updating = false;
                // Re-checked rather than assumed - confirms the update actually took before unblocking.
                _result = await VersionCheckService.CheckAsync(Device);
                await NotifyBlockingChanged();
                break;

            case FirmwareUpdateRunState.Failed:
                _updating = false;
                _updateError = $"Firmware update failed: {UpdateStatus.ErrorMessage}";
                await NotifyBlockingChanged();
                break;

            case FirmwareUpdateRunState.Idle:
                break;
        }
    }

    private async Task UpdateFirmware()
    {
        if (_result?.Bundle is not { } bundle || UpdateDisabledReason is not null)
        {
            return;
        }

        _updating = true;
        _updateError = null;
        _updateProgress = null;
        StateHasChanged();

        if (ConnectionModeProvider.Mode != PrinterConnectionMode.Wifi)
        {
            ConnectionModeProvider.UseWifi(WifiIpAddress!);
        }

        // Only starts the foreground service - FirmwareUpdateStatusMonitor.Changed (raised via
        // SetRunning()/SetProgress()/SetSucceeded()/SetFailed() from within the service) drives
        // everything from here, not this call's own completion.
        await FirmwareUpdateLauncher.StartAsync(Device, bundle, WifiIpAddress!);
    }

    private async Task Skip()
    {
        _skipped = true;
        await NotifyBlockingChanged();
    }

    private async Task Cancel() => await OnCancelled.InvokeAsync();

    private async Task NotifyBlockingChanged()
    {
        var isBlocking = Blocking;
        if (isBlocking != _wasBlocking)
        {
            _wasBlocking = isBlocking;
            if (isBlocking)
            {
                _activityToken = ActivityMonitor.Begin("Firmware Version Check");
            }
            else
            {
                _activityToken?.Dispose();
                _activityToken = null;
            }
        }

        StateHasChanged();
        await BlockingChanged.InvokeAsync(Blocking);
    }

    public void Dispose()
    {
        ConnectivityMonitor.Changed -= OnConnectivityChanged;
        UpdateStatus.Changed -= OnUpdateStatusChanged;
        _activityToken?.Dispose();
    }
}
