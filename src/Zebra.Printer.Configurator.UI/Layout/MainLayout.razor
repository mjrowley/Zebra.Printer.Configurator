@inherits LayoutComponentBase
@implements IDisposable
@inject IAppLog AppLog
@inject IAppVersionProvider AppVersionProvider
@inject PrinterConnectivityMonitor ConnectivityMonitor

<div class="app-layout">
    <header class="app-header" data-testid="app-header">
        <span class="app-name">Zebra Printer Configurator</span>
        <span class="app-version" data-testid="app-version">@AppVersionProvider.VersionLabel</span>
        <span class="header-indicators">
            <ConnectivityIndicator Kind="IndicatorKind.Bluetooth" State="ConnectivityMonitor.Bluetooth" />
            <ConnectivityIndicator Kind="IndicatorKind.Wifi" State="ConnectivityMonitor.Wifi" />
            <BackToPairingButton />
            <CancelWorkflowButton />
        </span>
    </header>

    <section class="function-section" data-testid="function-section">
        @Body
    </section>

    @* Starts collapsed (just the toggle bar) - the log used to permanently reserve 25% of the
       viewport, which on smaller screens left too little room below it for a page's own content to
       scroll into view (confirmed: PrinterActionsMenu's dropdown got clipped by function-section's
       own scroll boundary with the log eating a quarter of the remaining height). Expanded, it
       overlays the whole screen (position: fixed, not pushing function-section's layout around)
       with its own scrollable entry list - toggling doesn't remove log-entries from the DOM, just
       hides it via CSS, so it's still populated/scrolled-to-latest whenever it's next opened. *@
    <section class="log-panel @(_logExpanded ? "log-panel-expanded" : "log-panel-collapsed")" data-testid="log-panel">
        <button type="button" class="log-panel-toggle" data-testid="log-panel-toggle"
                aria-expanded="@(_logExpanded ? "true" : "false")"
                aria-label="@(_logExpanded ? "Collapse Activity Log" : "Expand Activity Log")"
                @onclick="() => _logExpanded = !_logExpanded">
            <h2>Activity Log</h2>
            <svg class="log-panel-toggle-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path fill="currentColor" d="M12 8l-6 6 1.41 1.41L12 10.83l4.59 4.58L18 14z" />
            </svg>
        </button>
        <div class="log-entries" data-testid="log-entries">
            @if (AppLog.Entries.Count == 0)
            {
                <p class="log-empty">No activity yet.</p>
            }
            else
            {
                @foreach (var entry in AppLog.Entries.Reverse())
                {
                    <div class="log-entry log-@entry.Level.ToString().ToLowerInvariant()" data-testid="log-entry">
                        <span class="log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                        <span class="log-message">@entry.Message</span>
                    </div>
                }
            }
        </div>
    </section>
</div>

@code {
    private bool _logExpanded;

    protected override void OnInitialized()
    {
        AppLog.EntryLogged += OnEntryLogged;
        ConnectivityMonitor.Changed += OnConnectivityChanged;
    }

    private void OnEntryLogged(object? sender, LogEntry entry) => InvokeAsync(StateHasChanged);

    private void OnConnectivityChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AppLog.EntryLogged -= OnEntryLogged;
        ConnectivityMonitor.Changed -= OnConnectivityChanged;
    }
}
