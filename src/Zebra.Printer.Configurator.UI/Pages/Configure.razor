@page "/configure"
@inject PairingSession Session
@inject IHostNetworkInfoService HostNetworkInfoService
@inject NavigationManager Navigation

<div class="section-sticky-header">
    <h1>WiFi Configuration</h1>

    @if (_loadingHostNetwork)
    {
        <p data-testid="host-network-loading">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Detecting your current WiFi network&hellip;
        </p>
    }
    else if (_hostNetworkError is not null)
    {
        <p class="text-danger" data-testid="host-network-error">@_hostNetworkError</p>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="ssid">WiFi SSID</label>
                <InputText id="ssid" class="form-control" @bind-Value="_model.Ssid" />
                <ValidationMessage For="() => _model.Ssid" />
            </div>

            <div class="mb-3">
                <label for="password">WiFi Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <div class="mb-3">
                <label for="ip-octet-1">Printer Static IP Address</label>
                <IpAddressInput @bind-Value="_model.StaticIpAddress" />
                <ValidationMessage For="() => _model.StaticIpAddress" />
            </div>

            <button type="submit" class="btn btn-primary">Continue</button>
        </EditForm>
    }
</div>

@code {
    private readonly ConfigureFormModel _model = new();
    private HostNetworkInfo? _hostNetworkInfo;
    private string? _hostNetworkError;
    private bool _loadingHostNetwork = true;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Device is null)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        // The phone is assumed to already be on the target WiFi network, so netmask/gateway are
        // inherited from its current connection rather than asked for in the form. Fetched here
        // (rather than at submit time) so a missing connection is surfaced immediately and the SSID
        // field can default to what the phone is already on.
        _hostNetworkInfo = await HostNetworkInfoService.GetCurrentAsync();
        _loadingHostNetwork = false;

        if (_hostNetworkInfo is null)
        {
            _hostNetworkError = "This device must be connected to the target WiFi network before configuring the printer.";
        }
        else if (!string.IsNullOrEmpty(_hostNetworkInfo.Ssid))
        {
            _model.Ssid = _hostNetworkInfo.Ssid;
        }
    }

    private void Submit()
    {
        if (_hostNetworkInfo is null)
        {
            return;
        }

        Session.Configuration = new WlanConfiguration
        {
            Ssid = _model.Ssid,
            Password = _model.Password,
            StaticIpAddress = _model.StaticIpAddress,
            Netmask = _hostNetworkInfo.Netmask,
            Gateway = _hostNetworkInfo.Gateway,
        };

        Navigation.NavigateTo("/progress");
    }

    private sealed class ConfigureFormModel
    {
        [Ssid]
        public string Ssid { get; set; } = string.Empty;

        [WifiPassword]
        public string Password { get; set; } = string.Empty;

        [IPv4Address]
        public string StaticIpAddress { get; set; } = string.Empty;
    }
}
