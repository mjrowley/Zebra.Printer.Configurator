@page "/configure"
@inject PairingSession Session
@inject IHostNetworkInfoService HostNetworkInfoService
@inject IPrinterModelReader ModelReader
@inject NavigationManager Navigation

<div class="section-sticky-header">
    <h1>WiFi Configuration</h1>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="configure-back-button" @onclick="Back">Back</button>

    @if (_loadingHostNetwork)
    {
        <p data-testid="host-network-loading">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Detecting your printer and current WiFi network&hellip;
        </p>
    }
    else if (_hostNetworkError is not null)
    {
        <p class="text-danger" data-testid="host-network-error">@_hostNetworkError</p>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="printer-name">Printer Name</label>
                <InputText id="printer-name" class="form-control" @bind-Value="_model.PrinterName" />
                <ValidationMessage For="() => _model.PrinterName" />
            </div>

            <div class="mb-3">
                <label for="ssid">WiFi SSID</label>
                <InputText id="ssid" class="form-control" @bind-Value="_model.Ssid" />
                <ValidationMessage For="() => _model.Ssid" />
            </div>

            <div class="mb-3">
                <label for="password">WiFi Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <div class="mb-3">
                <label for="ip-octet-1">Printer Static IP Address</label>
                <IpAddressInput @bind-Value="_model.StaticIpAddress" />
                <ValidationMessage For="() => _model.StaticIpAddress" />
            </div>

            <button type="submit" class="btn btn-primary">Continue</button>
        </EditForm>
    }
</div>

@code {
    private const string DefaultPrinterName = "ZD421";

    private readonly ConfigureFormModel _model = new();
    private HostNetworkInfo? _hostNetworkInfo;
    private string? _hostNetworkError;
    private bool _loadingHostNetwork = true;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Device is null)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        // Run in parallel - unrelated subsystems (Android WifiManager vs. a Bluetooth SGD read),
        // not a repeat of the "two concurrent Bluetooth connections" hazard documented elsewhere
        // in this app (that's specifically about two connections to the *printer* at once).
        var hostNetworkTask = HostNetworkInfoService.GetCurrentAsync();
        var printerNameTask = ReadPrinterNameOrDefaultAsync();
        await Task.WhenAll(hostNetworkTask, printerNameTask);

        // The phone is assumed to already be on the target WiFi network, so netmask/gateway are
        // inherited from its current connection rather than asked for in the form. Fetched here
        // (rather than at submit time) so a missing connection is surfaced immediately and the SSID
        // field can default to what the phone is already on.
        _hostNetworkInfo = hostNetworkTask.Result;
        _model.PrinterName = printerNameTask.Result;
        _loadingHostNetwork = false;

        if (_hostNetworkInfo is null)
        {
            _hostNetworkError = "This device must be connected to the target WiFi network before configuring the printer.";
            return;
        }

        if (!string.IsNullOrEmpty(_hostNetworkInfo.Ssid))
        {
            _model.Ssid = _hostNetworkInfo.Ssid;
        }

        // The printer is assumed to join the same subnet the phone is already on, so its first 3
        // octets can be pre-filled from the phone's own IP - the user only has to fill in the last
        // octet. Only applies when the field is still blank, which today is always true here (this
        // page starts a fresh ConfigureFormModel on every load, including reconfiguring an
        // already-configured printer), but checked explicitly so a future default wouldn't be
        // silently overwritten.
        var hostOctets = _hostNetworkInfo.HostIpAddress.Split('.');
        if (string.IsNullOrEmpty(_model.StaticIpAddress) && hostOctets.Length == 4)
        {
            _model.StaticIpAddress = string.Join('.', hostOctets.Take(3));
        }
    }

    // A failed/blank live read must not block the whole form the way a missing host network
    // correctly does above - no WiFi means configuration is genuinely impossible, but a failed
    // printer-name pre-fill is just a cosmetic default the user can retype.
    private async Task<string> ReadPrinterNameOrDefaultAsync()
    {
        try
        {
            var modelName = await ModelReader.ReadModelNameAsync(Session.Device!);
            return string.IsNullOrWhiteSpace(modelName) ? DefaultPrinterName : modelName;
        }
        catch (Exception)
        {
            return DefaultPrinterName;
        }
    }

    private void Submit()
    {
        if (_hostNetworkInfo is null)
        {
            return;
        }

        Session.Configuration = new WlanConfiguration
        {
            PrinterName = _model.PrinterName,
            Ssid = _model.Ssid,
            Password = _model.Password,
            StaticIpAddress = _model.StaticIpAddress,
            Netmask = _hostNetworkInfo.Netmask,
            Gateway = _hostNetworkInfo.Gateway,
        };

        Navigation.NavigateTo("/progress");
    }

    // Deliberately does not touch Session - Pairing.razor now shows its Ready state directly for an
    // already-paired Session.Device instead of resetting and waiting for a fresh tap, so returning
    // there preserves the printer without forcing a re-tap.
    private void Back() => Navigation.NavigateTo("/");

    private sealed class ConfigureFormModel
    {
        [PrinterName]
        public string PrinterName { get; set; } = string.Empty;

        [Ssid]
        public string Ssid { get; set; } = string.Empty;

        [WifiPassword]
        public string Password { get; set; } = string.Empty;

        [IPv4Address]
        public string StaticIpAddress { get; set; } = string.Empty;
    }
}
