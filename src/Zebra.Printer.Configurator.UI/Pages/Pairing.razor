@page "/"
@implements IDisposable
@inject IPrinterDiscoveryService DiscoveryService
@inject IBluetoothPairingService BluetoothPairingService
@inject IAppLog AppLog
@inject PairingSession Session
@inject PrinterConnectivityMonitor ConnectivityMonitor
@inject IWifiConnectivityMonitor WifiMonitor
@inject IPrinterConnectionModeProvider ConnectionModeProvider
@inject NavigationManager Navigation

<div class="section-sticky-header">
    <h1>@FunctionName</h1>

    @switch (_state)
    {
        case PairingUiState.WaitingForTap:
            <p data-testid="pairing-mode-instruction-wifi">
                <strong>1. Ensure this device is connected to the store WiFi network.</strong>
            </p>
            <p data-testid="pairing-mode-instruction">
                <strong>2. On the printer, hold down the label feed button for 5 seconds until it enters pairing mode.</strong>
            </p>
            <p data-testid="pairing-mode-instruction-nfc">
                <strong>3. Tap this device to the printer 'NFC' icon to begin.</strong>
                <br />
                <img src="images/Zebra_NFC_Icon.png" alt="NFC icon" height="36" style="margin-top: 0.25rem;" />
            </p>
            break;

        case PairingUiState.Pairing:
            <p data-testid="pairing-in-progress">
                <md-circular-progress indeterminate class="spinner-inline"></md-circular-progress>
                Pairing with printer&hellip;
            </p>
            break;

        case PairingUiState.Failed:
            <p class="status-text-error" data-testid="pairing-error">@_errorMessage</p>
            <md-filled-button type="button" @onclick="Retry">Try Again</md-filled-button>
            break;
    }
</div>

@* Shown the moment NFC discovers a printer, before the actual Bluetooth pairing negotiation starts -
   mirrors Zebra's own Nucleus Connector app, which gates on the same "move away" confirmation here.
   The phone is necessarily right up against the printer's NFC antenna at the point of tap, and this
   printer bonds over BLE and Classic/BR-EDR independently (see [[bluetooth-pairing-dual-transport]]) -
   starting that negotiation while still in the NFC field is the most likely explanation for why Zebra
   gates it behind an explicit user action instead of proceeding automatically, though this app has no
   direct on-device confirmation of that mechanism itself. *@
@if (_showNfcTapDialog)
{
    <div class="confirm-modal-backdrop" data-testid="nfc-tap-received-dialog">
        <div class="confirm-modal-box" role="alertdialog">
            <h2>NFC Tap Received</h2>
            <p>We received your NFC tap. Please move your device away from the printer to proceed.</p>
            <div class="confirm-modal-actions">
                <md-filled-button type="button" data-testid="nfc-tap-received-continue" @onclick="ContinuePairing">Continue</md-filled-button>
            </div>
        </div>
    </div>
}

@code {
    private enum PairingUiState
    {
        WaitingForTap,
        Pairing,
        Failed,
    }

    private PairingUiState _state = PairingUiState.WaitingForTap;
    private string? _errorMessage;
    private bool _showNfcTapDialog;
    private PrinterDevice? _pendingDevice;

    private string FunctionName => _state switch
    {
        PairingUiState.WaitingForTap => "Pair a Printer",
        PairingUiState.Pairing => "NFC/BT Pairing",
        PairingUiState.Failed => "Pairing Failed",
        _ => "Pair a Printer",
    };

    // Session.Device is only ever populated once pairing actually succeeds below (or was already set
    // by an earlier pairing attempt this session) - landing here with one already set means some
    // other page (Configure.razor's Back button today) navigated back rather than this being a fresh
    // app launch or an explicit Disconnect/Cancel - those clear Session.Device themselves before
    // navigating here specifically so this still takes the fresh-scan path below. Restoring goes
    // straight to the dashboard rather than waiting for a re-tap, since the printer is still bonded
    // either way.
    protected override void OnInitialized()
    {
        if (Session.Device is not null)
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }

        Session.Reset();
        ConnectivityMonitor.Reset();
        WifiMonitor.Stop();
        ConnectionModeProvider.UseBluetooth();
        DiscoveryService.PrinterDiscovered += OnPrinterDiscovered;
        DiscoveryService.StartListening();
    }

    private void OnPrinterDiscovered(object? sender, PrinterDevice device)
    {
        InvokeAsync(() =>
        {
            // A single physical NFC tap has been observed dispatching more than one intent
            // (confirmed on-device: the printer displayed two different pairing codes and
            // Android's pairing dialog appeared twice) - a second discovery arriving while one is
            // already being handled (including while the NFC Tap Received dialog is still up,
            // waiting on the user) is ignored rather than starting a concurrent CreateBond()
            // attempt against the same printer. _showNfcTapDialog is set below before this method
            // returns, so a second call queued via InvokeAsync always sees it by the time it runs.
            if (_state != PairingUiState.WaitingForTap || _showNfcTapDialog)
            {
                AppLog.Log("Ignoring duplicate NFC discovery - already pairing.", LogLevel.Warning);
                return;
            }

            _pendingDevice = device;
            _showNfcTapDialog = true;
            StateHasChanged();
        });
    }

    // "Continue" on the NFC Tap Received dialog - only past this point does the actual Bluetooth
    // pairing negotiation begin.
    private Task ContinuePairing()
    {
        if (_pendingDevice is null)
        {
            return Task.CompletedTask;
        }

        var device = _pendingDevice;
        _pendingDevice = null;
        _showNfcTapDialog = false;
        return StartPairingAsync(device);
    }

    private async Task StartPairingAsync(PrinterDevice device)
    {
        _state = PairingUiState.Pairing;
        ConnectivityMonitor.SetBluetooth(ConnectionIndicatorState.Connecting);
        StateHasChanged();

        var paired = await BluetoothPairingService.EnsurePairedAsync(device.BluetoothMacAddress);

        ConnectivityMonitor.SetBluetooth(paired ? ConnectionIndicatorState.Connected : ConnectionIndicatorState.Error);

        if (paired)
        {
            Session.Device = device;
            Navigation.NavigateTo("/dashboard");
            return;
        }

        _errorMessage = "Could not pair with the printer. Make sure it's powered on and in range, then try again.";
        _state = PairingUiState.Failed;
        StateHasChanged();
    }

    private void Retry()
    {
        _errorMessage = null;
        _showNfcTapDialog = false;
        _pendingDevice = null;
        ConnectivityMonitor.Reset();
        WifiMonitor.Stop();
        ConnectionModeProvider.UseBluetooth();
        _state = PairingUiState.WaitingForTap;
    }

    public void Dispose()
    {
        DiscoveryService.PrinterDiscovered -= OnPrinterDiscovered;
        DiscoveryService.StopListening();
    }
}
