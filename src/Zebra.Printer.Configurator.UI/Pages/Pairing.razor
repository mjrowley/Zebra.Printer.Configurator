@page "/"
@implements IDisposable
@inject IPrinterDiscoveryService DiscoveryService
@inject IBluetoothPairingService BluetoothPairingService
@inject IPrinterFactoryResetService FactoryResetService
@inject PairingSession Session
@inject NavigationManager Navigation

<h1>Pair a Printer</h1>

@switch (_state)
{
    case PairingUiState.WaitingForTap:
        <p data-testid="pairing-mode-instruction">
            On the printer, hold down the label feed button for 5 seconds until it enters pairing mode.
        </p>
        <p>Tap your Zebra printer to the back of your phone to begin.</p>
        break;

    case PairingUiState.Pairing:
        <p data-testid="pairing-in-progress">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Pairing with printer&hellip;
        </p>
        break;

    case PairingUiState.ConfirmingCode:
        <p data-testid="pairing-code">
            Confirm this code matches the code shown on the printer: <strong>@_pairingCode</strong>
        </p>
        <button type="button" class="btn btn-primary" @onclick="ConfirmPairingCode">Pair</button>
        <button type="button" class="btn btn-secondary" @onclick="RejectPairingCode">Cancel</button>
        break;

    case PairingUiState.Ready:
        <p data-testid="discovered-device">
            Printer found@(_discoveredDevice?.SerialNumber is not null ? $" (serial {_discoveredDevice.SerialNumber})" : ".")
        </p>
        <button type="button" class="btn btn-primary" @onclick="Continue">Configure Printer</button>
        <button type="button" class="btn btn-outline-danger" data-testid="factory-reset-button" @onclick="RequestFactoryReset">Factory Reset</button>
        break;

    case PairingUiState.ConfirmingFactoryReset:
        <p class="text-danger" data-testid="factory-reset-warning">
            This erases all settings on the printer and restores factory defaults. It may also break
            the Bluetooth pairing you just completed. Continue?
        </p>
        <button type="button" class="btn btn-danger" data-testid="factory-reset-confirm" @onclick="ConfirmFactoryReset">Factory Reset</button>
        <button type="button" class="btn btn-secondary" data-testid="factory-reset-cancel" @onclick="CancelFactoryReset">Cancel</button>
        break;

    case PairingUiState.ResettingToFactoryDefaults:
        <p data-testid="factory-reset-progress">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            Resetting printer to factory defaults&hellip;
        </p>
        break;

    case PairingUiState.FactoryResetComplete:
        <p data-testid="factory-reset-complete">
            Factory reset command sent. The printer will restart with default settings - you may need
            to pair again.
        </p>
        <button type="button" class="btn btn-primary" @onclick="Retry">Start Over</button>
        break;

    case PairingUiState.Failed:
        <p class="text-danger" data-testid="pairing-error">@_errorMessage</p>
        <button type="button" class="btn btn-primary" @onclick="Retry">Try Again</button>
        break;
}

@code {
    private enum PairingUiState
    {
        WaitingForTap,
        Pairing,
        ConfirmingCode,
        Ready,
        ConfirmingFactoryReset,
        ResettingToFactoryDefaults,
        FactoryResetComplete,
        Failed,
    }

    private PairingUiState _state = PairingUiState.WaitingForTap;
    private PrinterDevice? _discoveredDevice;
    private string? _pairingCode;
    private string? _errorMessage;
    private PairingCodeRequestedEventArgs? _pendingPairingRequest;

    protected override void OnInitialized()
    {
        Session.Reset();
        DiscoveryService.PrinterDiscovered += OnPrinterDiscovered;
        BluetoothPairingService.PairingCodeRequested += OnPairingCodeRequested;
        DiscoveryService.StartListening();
    }

    private void OnPrinterDiscovered(object? sender, PrinterDevice device)
    {
        InvokeAsync(async () =>
        {
            _discoveredDevice = device;
            _state = PairingUiState.Pairing;
            StateHasChanged();

            var paired = await BluetoothPairingService.EnsurePairedAsync(device.BluetoothMacAddress);

            _state = paired ? PairingUiState.Ready : PairingUiState.Failed;
            _errorMessage = paired
                ? null
                : "Could not pair with the printer. Make sure it's powered on and in range, then try again.";
            StateHasChanged();
        });
    }

    private void OnPairingCodeRequested(object? sender, PairingCodeRequestedEventArgs args)
    {
        InvokeAsync(() =>
        {
            _pendingPairingRequest = args;
            _pairingCode = args.PairingCode;
            _state = PairingUiState.ConfirmingCode;
            StateHasChanged();
        });
    }

    private void ConfirmPairingCode() => RespondToPairingCode(accepted: true);

    private void RejectPairingCode() => RespondToPairingCode(accepted: false);

    private void RespondToPairingCode(bool accepted)
    {
        // Set state before resolving Response: TrySetResult can run the awaiter's continuation
        // (which advances _state again, e.g. to Ready/Failed) synchronously, so nothing here should
        // run after it that could stomp on that.
        var request = _pendingPairingRequest;
        _pendingPairingRequest = null;
        _state = PairingUiState.Pairing;
        request?.Response.TrySetResult(accepted);
    }

    private void Continue()
    {
        if (_discoveredDevice is null)
        {
            return;
        }

        Session.Device = _discoveredDevice;
        Navigation.NavigateTo("/configure");
    }

    private void RequestFactoryReset() => _state = PairingUiState.ConfirmingFactoryReset;

    private void CancelFactoryReset() => _state = PairingUiState.Ready;

    private async Task ConfirmFactoryReset()
    {
        if (_discoveredDevice is null)
        {
            return;
        }

        _state = PairingUiState.ResettingToFactoryDefaults;

        try
        {
            await FactoryResetService.ResetToFactoryDefaultsAsync(_discoveredDevice);
            _state = PairingUiState.FactoryResetComplete;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Factory reset failed: {ex.Message}";
            _state = PairingUiState.Failed;
        }
    }

    private void Retry()
    {
        _discoveredDevice = null;
        _errorMessage = null;
        _state = PairingUiState.WaitingForTap;
    }

    public void Dispose()
    {
        DiscoveryService.PrinterDiscovered -= OnPrinterDiscovered;
        BluetoothPairingService.PairingCodeRequested -= OnPairingCodeRequested;
        DiscoveryService.StopListening();
    }
}
