@page "/"
@implements IDisposable
@inject IPrinterDiscoveryService DiscoveryService
@inject IBluetoothPairingService BluetoothPairingService
@inject IPrinterConfigurationReader ConfigurationReader
@inject IAppLog AppLog
@inject PairingSession Session
@inject PrinterConnectivityMonitor ConnectivityMonitor
@inject IWifiConnectivityMonitor WifiMonitor
@inject IPrinterConnectionModeProvider ConnectionModeProvider
@inject NavigationManager Navigation

<div class="section-sticky-header">
    <h1>@FunctionName</h1>

    @switch (_state)
    {
        case PairingUiState.WaitingForTap:
            <p data-testid="pairing-mode-instruction-wifi">
                <strong>1. Ensure this device is connected to the store WiFi network.</strong>
            </p>
            <p data-testid="pairing-mode-instruction">
                <strong>2. On the printer, hold down the label feed button for 5 seconds until it enters pairing mode.</strong>
            </p>
            <p data-testid="pairing-mode-instruction-nfc">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="align-middle me-1">
                    <rect x="8" y="7" width="11" height="16" rx="2" />
                    <path d="M6 5a10 10 0 0 1 7 7" stroke-linecap="round" />
                    <path d="M4 8a6 6 0 0 1 5 5" stroke-linecap="round" />
                </svg>
                <strong>3. Tap this device to the printer 'NFC' icon to begin.</strong>
            </p>
            break;

        case PairingUiState.Pairing:
            <p data-testid="pairing-in-progress">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                Pairing with printer&hellip;
            </p>
            break;

        case PairingUiState.Ready:
            <div class="status-card">
                <h2>Printer Paired</h2>
                <p data-testid="discovered-device">
                    Printer found@(_discoveredDevice?.SerialNumber is not null ? $" (serial {_discoveredDevice.SerialNumber})" : ".")
                </p>
                <PrinterVersionAlert Device="_discoveredDevice!" WifiIpAddress="@_wifiIpAddress" BlockingChanged="OnVersionCheckBlockingChanged" OnCancelled="Retry" />
            </div>
            <div class="button-row">
                <button type="button" class="btn btn-primary" data-testid="configure-printer-button" disabled="@(_factoryResetActive || _templatesActive || _versionCheckBlocking)" @onclick="Continue">Configure Printer</button>
                <FactoryResetPanel Device="_discoveredDevice!" OnFinished="Retry" IsActiveChanged="OnFactoryResetActiveChanged" />
                <CheckConfigurationButton Device="_discoveredDevice!" State="_checkConfigState" Disabled="@(_factoryResetActive || _templatesActive)" />
                <BagTagTemplatesPanel Device="_discoveredDevice!" IsActiveChanged="OnTemplatesActiveChanged" />
            </div>
            break;

        case PairingUiState.Failed:
            <p class="text-danger" data-testid="pairing-error">@_errorMessage</p>
            <button type="button" class="btn btn-primary" @onclick="Retry">Try Again</button>
            break;
    }
</div>

@if (_state == PairingUiState.Ready)
{
    <CheckConfigurationResults State="_checkConfigState" />
}

@code {
    private enum PairingUiState
    {
        WaitingForTap,
        Pairing,
        Ready,
        Failed,
    }

    private const int DefaultWifiProbePort = 6101;
    private static readonly TimeSpan WifiProbeTimeout = TimeSpan.FromSeconds(3);

    // Overridable (rather than a plain const) so component tests can point the reachability probe
    // at a local TcpListener on a free port instead of the real, fixed SGD port.
    [Parameter]
    public int WifiProbePort { get; set; } = DefaultWifiProbePort;

    private PairingUiState _state = PairingUiState.WaitingForTap;
    private PrinterDevice? _discoveredDevice;
    private string? _errorMessage;
    private bool _factoryResetActive;
    private bool _templatesActive;
    private bool _versionCheckBlocking;
    private string? _wifiIpAddress;
    private CheckConfigurationState _checkConfigState = new();

    private string FunctionName => _state switch
    {
        PairingUiState.WaitingForTap => "Pair a Printer",
        PairingUiState.Pairing => "NFC/BT Pairing",
        PairingUiState.Ready => "Printer Paired",
        PairingUiState.Failed => "Pairing Failed",
        _ => "Pair a Printer",
    };

    // Session.Device is only ever populated by Continue() below, so landing here with one already
    // set means some other page (Configure.razor's Back button today) navigated back to an
    // already-paired printer rather than this being a fresh app launch or an explicit Retry/Cancel -
    // those clear Session.Device themselves before navigating here specifically so this still takes
    // the fresh-scan path below. Restoring goes straight to Ready with a re-run WiFi check rather
    // than waiting for a re-tap, since the printer is still bonded either way.
    protected override async Task OnInitializedAsync()
    {
        if (Session.Device is not null)
        {
            _discoveredDevice = Session.Device;
            _checkConfigState = new CheckConfigurationState();
            _state = PairingUiState.Ready;
            ConnectivityMonitor.SetBluetooth(ConnectionIndicatorState.Connected);
            StateHasChanged();
            await CheckWifiConnectivityAsync(_discoveredDevice);
            return;
        }

        Session.Reset();
        ConnectivityMonitor.Reset();
        WifiMonitor.Stop();
        ConnectionModeProvider.UseBluetooth();
        DiscoveryService.PrinterDiscovered += OnPrinterDiscovered;
        DiscoveryService.StartListening();
    }

    private void OnPrinterDiscovered(object? sender, PrinterDevice device)
    {
        InvokeAsync(async () =>
        {
            // A single physical NFC tap has been observed dispatching more than one intent
            // (confirmed on-device: the printer displayed two different pairing codes and
            // Android's pairing dialog appeared twice) - a second discovery arriving while one is
            // already being handled is ignored rather than starting a concurrent CreateBond()
            // attempt against the same printer. State is set to Pairing below before the only
            // await point in this method, so a second call queued via InvokeAsync always sees it
            // by the time it runs.
            if (_state != PairingUiState.WaitingForTap)
            {
                AppLog.Log("Ignoring duplicate NFC discovery - already pairing.", LogLevel.Warning);
                return;
            }

            _discoveredDevice = device;
            _checkConfigState = new CheckConfigurationState();
            _state = PairingUiState.Pairing;
            ConnectivityMonitor.SetBluetooth(ConnectionIndicatorState.Connecting);
            StateHasChanged();

            var paired = await BluetoothPairingService.EnsurePairedAsync(device.BluetoothMacAddress);

            ConnectivityMonitor.SetBluetooth(paired ? ConnectionIndicatorState.Connected : ConnectionIndicatorState.Error);
            _errorMessage = paired
                ? null
                : "Could not pair with the printer. Make sure it's powered on and in range, then try again.";
            StateHasChanged();

            if (paired)
            {
                // Runs before entering Ready - which is when PrinterVersionAlert mounts and starts
                // its own Bluetooth connection to check firmware versions. Bluetooth Classic only
                // reliably supports one active connection to this printer at a time, so this and
                // that check must not run concurrently (confirmed on-device: running them in
                // parallel produced a corrupted/empty WiFi IP address that then broke the firmware
                // update's TcpConnection with a cryptic "hostname nor servname provided" error).
                await CheckWifiConnectivityAsync(device);
            }

            _state = paired ? PairingUiState.Ready : PairingUiState.Failed;
            StateHasChanged();
        });
    }

    // Runs automatically whenever a tap either freshly pairs or finds a printer already bonded -
    // covers both a brand-new printer and re-tapping one that was already configured on WiFi in an
    // earlier session, where Bluetooth pairing alone gives no indication of WiFi reachability at all.
    // Uses the Bluetooth link that's already just been confirmed to ask the printer for its own
    // wlan.ip.addr, rather than requiring the user to press "Check Configuration" first.
    private async Task CheckWifiConnectivityAsync(PrinterDevice device)
    {
        ConnectivityMonitor.SetWifi(ConnectionIndicatorState.Connecting);
        StateHasChanged();

        try
        {
            // allowBleFallback: false - this runs immediately after a fresh Bluetooth bond, and a
            // BLE fallback attempted that soon can silently trigger a second, unexpected OS pairing
            // dialog (see PrinterConnectionRunner's own doc comment).
            var values = await ConfigurationReader.ReadConfigurationAsync(device, allowBleFallback: false);
            var ipAddress = values.FirstOrDefault(v => v.Key == "wlan.ip.addr")?.Value;

            if (string.IsNullOrWhiteSpace(ipAddress) || ipAddress == "0.0.0.0")
            {
                AppLog.Log("Printer does not have a WiFi connection configured.", LogLevel.Warning);
                ConnectivityMonitor.SetWifi(ConnectionIndicatorState.Error);
                StateHasChanged();
                return;
            }

            _wifiIpAddress = ipAddress;
            var reachable = await TcpPortProbe.IsReachableAsync(ipAddress, WifiProbePort, WifiProbeTimeout);
            AppLog.Log(
                reachable
                    ? $"Printer is reachable via WiFi at {ipAddress}."
                    : $"Printer is not currently reachable via WiFi at {ipAddress}.",
                reachable ? LogLevel.Success : LogLevel.Warning);
            ConnectivityMonitor.SetWifi(reachable ? ConnectionIndicatorState.Connected : ConnectionIndicatorState.Error);
            StateHasChanged();

            // Keeps the indicator live afterward regardless of this first result - the printer may
            // still be finishing its own WiFi association right after a reboot/re-tap.
            WifiMonitor.Start(ipAddress);
        }
        catch (Exception ex)
        {
            AppLog.Log($"Could not check WiFi connectivity: {ex.Message}", LogLevel.Warning);
            ConnectivityMonitor.SetWifi(ConnectionIndicatorState.Error);
            StateHasChanged();
        }
    }

    private void Continue()
    {
        if (_discoveredDevice is null || _factoryResetActive)
        {
            return;
        }

        Session.Device = _discoveredDevice;
        Navigation.NavigateTo("/configure");
    }

    private void OnFactoryResetActiveChanged(bool active) => _factoryResetActive = active;

    private void OnTemplatesActiveChanged(bool active) => _templatesActive = active;

    private void OnVersionCheckBlockingChanged(bool blocking) => _versionCheckBlocking = blocking;

    private void Retry()
    {
        _discoveredDevice = null;
        _errorMessage = null;
        _factoryResetActive = false;
        _templatesActive = false;
        _versionCheckBlocking = false;
        _wifiIpAddress = null;
        _checkConfigState = new CheckConfigurationState();
        ConnectivityMonitor.Reset();
        WifiMonitor.Stop();
        ConnectionModeProvider.UseBluetooth();
        _state = PairingUiState.WaitingForTap;
    }

    public void Dispose()
    {
        DiscoveryService.PrinterDiscovered -= OnPrinterDiscovered;
        DiscoveryService.StopListening();
    }
}
