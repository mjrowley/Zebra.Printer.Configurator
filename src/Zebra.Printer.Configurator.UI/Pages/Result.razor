@page "/result"
@inject PairAndConfigureWorkflow Workflow
@inject PairingSession Session
@inject PrinterConnectivityMonitor ConnectivityMonitor
@inject IWifiConnectivityMonitor WifiMonitor
@inject IPrinterConnectionModeProvider ConnectionModeProvider
@inject NavigationManager Navigation

@* Only ever actually renders the Failed branch - a Succeeded workflow redirects straight to
   PrinterDashboard.razor (which shows its own "Connected to Ssid at ResolvedIpAddress" success
   banner by checking Workflow.State itself) instead of duplicating that whole status-card/
   PrinterVersionAlert/WebInterfaceTogglePanel/PrinterActionsMenu layout here a second time. *@
<div class="section-sticky-header">
    <h1>Configuration Failed</h1>
    <p data-testid="result-failure">@(Workflow.FailureReason ?? "An unknown error occurred.")</p>
    <md-filled-button type="button" @onclick="Retry">Retry</md-filled-button>
</div>

@code {
    protected override void OnInitialized()
    {
        if (Workflow.State == PairingWorkflowState.Succeeded)
        {
            Navigation.NavigateTo("/dashboard", replace: true);
            return;
        }

        if (Workflow.State != PairingWorkflowState.Failed)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }

    private void Retry()
    {
        Session.Reset();
        ConnectivityMonitor.Reset();
        WifiMonitor.Stop();
        ConnectionModeProvider.UseBluetooth();
        Navigation.NavigateTo("/", replace: true);
    }
}
