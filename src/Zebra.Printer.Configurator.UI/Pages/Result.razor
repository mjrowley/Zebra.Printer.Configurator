@page "/result"
@inject PairAndConfigureWorkflow Workflow
@inject PairingSession Session
@inject PrinterConnectivityMonitor ConnectivityMonitor
@inject PrinterActivityMonitor ActivityMonitor
@inject IWifiConnectivityMonitor WifiMonitor
@inject IPrinterConnectionModeProvider ConnectionModeProvider
@inject IPrinterStatusReader StatusReader
@inject NavigationManager Navigation

<div class="section-sticky-header">
    @if (Workflow.State == PairingWorkflowState.Succeeded)
    {
        <h1>Success</h1>
        <div class="status-card">
            <h2>Success</h2>
            <p data-testid="result-success">
                The printer is now connected to @Session.Configuration?.Ssid at @Session.Configuration?.StaticIpAddress.
            </p>
            @* The printer now has a confirmed working WiFi connection (Session.Configuration.StaticIpAddress,
               just verified by the workflow's own connectivity test) - re-surfaces the same version
               check/update offer here, since Pairing.razor's earlier check may have let a NeedsUpdate
               result through unblocked if WiFi wasn't available yet at that point. *@
            <PrinterVersionAlert Device="Session.Device!" WifiIpAddress="@Session.Configuration?.StaticIpAddress" VersionResult="_printerStatus?.VersionResult" StatusLoading="_statusLoading" OnCancelled="Retry" />
        </div>
        <div class="button-row">
            <button type="button" class="btn btn-primary" data-testid="reconfigure-button" disabled="@(_factoryResetActive || _templatesActive || _checkingNetwork || _webInterfaceActive || _statusLoading)" @onclick="Reconfigure">
                @if (_checkingNetwork)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                Reconfigure Printer
            </button>
            <FactoryResetPanel Device="Session.Device!" OnFinished="Retry" IsActiveChanged="OnFactoryResetActiveChanged" />
            <CheckConfigurationButton State="_checkConfigState" Disabled="@(_factoryResetActive || _templatesActive || _webInterfaceActive)" OnRecheck="RecheckConfigurationAsync" />
            <BagTagTemplatesPanel Device="Session.Device!" IsActiveChanged="OnTemplatesActiveChanged" />
            <WebInterfaceTogglePanel Device="Session.Device!" InitialState="_printerStatus?.WebInterfaceState" StatusLoading="_statusLoading" IsActiveChanged="OnWebInterfaceActiveChanged" />
        </div>
    }
    else
    {
        <h1>Configuration Failed</h1>
        <p data-testid="result-failure">@(Workflow.FailureReason ?? "An unknown error occurred.")</p>
        <button type="button" class="btn btn-primary" @onclick="Retry">Retry</button>
    }
</div>

@if (Workflow.State == PairingWorkflowState.Succeeded)
{
    <CheckConfigurationResults State="_checkConfigState" />
}

@code {
    private const int DefaultWifiProbePort = 6101;
    private static readonly TimeSpan NetworkProbeTimeout = TimeSpan.FromSeconds(3);

    // Overridable (rather than a plain const) so component tests can point the reachability probe
    // at a local TcpListener on a free port instead of the real, fixed SGD port.
    [Parameter]
    public int WifiProbePort { get; set; } = DefaultWifiProbePort;

    private bool _factoryResetActive;
    private bool _templatesActive;
    private bool _checkingNetwork;
    private bool _webInterfaceActive;
    private CheckConfigurationState _checkConfigState = new();
    private PrinterStatus? _printerStatus;
    private bool _statusLoading;

    // Sets the loading flags synchronously, before Blazor's first render - this page's markup
    // (unlike Pairing.razor's _state-gated switch) already shows the Succeeded button-row on its
    // very first render with no intermediate loading gate, so PrinterVersionAlert/
    // WebInterfaceTogglePanel's first parameter-set must already see StatusLoading = true here, not
    // in OnInitializedAsync (too late - that only delays rendering if it doesn't finish
    // synchronously, which setting a plain bool always does).
    protected override void OnInitialized()
    {
        if (Workflow.State is not (PairingWorkflowState.Succeeded or PairingWorkflowState.Failed))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        if (Workflow.State == PairingWorkflowState.Succeeded)
        {
            _statusLoading = true;
            _checkConfigState.SetLoading();
        }
    }

    protected override Task OnInitializedAsync() =>
        Workflow.State == PairingWorkflowState.Succeeded
            ? LoadPrinterStatusAsync(Session.Device!, allowBleFallback: true)
            : Task.CompletedTask;

    // Mirrors Zebra's own Printer Setup Utility's documented connection search order - network
    // first, Bluetooth after - for reconfiguring a printer this app already successfully configured
    // and confirmed on WiFi this session, so the static IP it was just given is the obvious thing to
    // try first rather than reconnecting over Bluetooth by default. First-time pairing (Pairing.razor)
    // deliberately skips this: a never-configured printer has no WiFi yet, so there's no IP to probe.
    private async Task Reconfigure()
    {
        if (_factoryResetActive || _templatesActive || _checkingNetwork)
        {
            return;
        }

        var ipAddress = Session.Configuration?.StaticIpAddress;
        _checkingNetwork = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(ipAddress) && await TcpPortProbe.IsReachableAsync(ipAddress, WifiProbePort, NetworkProbeTimeout))
            {
                ConnectionModeProvider.UseWifi(ipAddress);
                ConnectivityMonitor.SetBluetooth(ConnectionIndicatorState.Disconnected);
                ConnectivityMonitor.SetWifi(ConnectionIndicatorState.Connected);
                WifiMonitor.Start(ipAddress);
            }
            else
            {
                ConnectionModeProvider.UseBluetooth();
            }
        }
        finally
        {
            _checkingNetwork = false;
        }

        Navigation.NavigateTo("/configure");
    }

    // Reads firmware version + web interface state + the full configuration list in one connection
    // (see PrinterStatus's own doc comment) - populates PrinterVersionAlert/WebInterfaceTogglePanel
    // via their VersionResult/InitialState + StatusLoading parameters, and CheckConfigurationResults
    // via _checkConfigState, so the configuration list appears automatically rather than only after
    // a manual click.
    private async Task LoadPrinterStatusAsync(PrinterDevice device, bool allowBleFallback)
    {
        using var _ = ActivityMonitor.Begin("Printer Status Check");
        try
        {
            _printerStatus = await StatusReader.ReadStatusAsync(device, allowBleFallback);
            _checkConfigState.SetResults(_printerStatus.ConfigurationValues);
        }
        catch (Exception ex)
        {
            _printerStatus = null;
            _checkConfigState.SetError($"Could not check printer status: {ex.Message}");
        }
        finally
        {
            _statusLoading = false;
            StateHasChanged();
        }
    }

    // "Recheck Configuration" button - re-runs the same merged read as the automatic first check,
    // refreshing the firmware status/web interface state/configuration list together.
    private Task RecheckConfigurationAsync()
    {
        if (Session.Device is null)
        {
            return Task.CompletedTask;
        }

        _printerStatus = null;
        _statusLoading = true;
        _checkConfigState.SetLoading();
        StateHasChanged();
        return LoadPrinterStatusAsync(Session.Device, allowBleFallback: true);
    }

    private void OnFactoryResetActiveChanged(bool active) => _factoryResetActive = active;

    private void OnTemplatesActiveChanged(bool active) => _templatesActive = active;

    private void OnWebInterfaceActiveChanged(bool active) => _webInterfaceActive = active;

    private void Retry()
    {
        Session.Reset();
        ConnectivityMonitor.Reset();
        WifiMonitor.Stop();
        ConnectionModeProvider.UseBluetooth();
        Navigation.NavigateTo("/", replace: true);
    }
}
